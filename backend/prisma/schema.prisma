generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  client
  advertiser_individual
  real_estate_agency
  hotel_manager
  vehicle_renter
  vehicle_dealer
  chauffeur
  transport_provider
  admin
}

enum AccountStatus {
  active
  pending_verification
  suspended
  deleted
}

enum ProfessionalType {
  real_estate_agency
  hotel
  auberge
  residence
  vehicle_renter
  vehicle_dealer
  chauffeur
  transport_provider
  other
}

enum PencmiModule {
  real_estate
  hotels
  vehicles
  trips
  messages
  users
  content
  support
  system
}

enum ListingStatus {
  draft
  pending_review
  active
  refused
  suspended
  expired
  deleted
}

enum RequestStatus {
  new
  pending
  accepted
  refused
  cancelled
  expired
  completed
  requires_more_info
}

enum ContactSource {
  whatsapp
  phone
  email
  internal_message
  form
  visit_request
  reservation_request
  rental_request
  chauffeur_request
  seat_request
}

enum NotificationStatus {
  unread
  read
  archived
}

enum NotificationPriority {
  low
  normal
  important
  urgent
}

enum ReportStatus {
  new
  in_progress
  correction_requested
  resolved
  rejected
  archived
}

enum ReportPriority {
  low
  normal
  important
  urgent
}

enum TargetType {
  listing
  user
  advertiser
  message
  conversation
  document
  other
}

enum FileVisibility {
  public
  private
}

enum EmailStatus {
  pending
  sent
  failed
  cancelled
}

enum SupportTicketStatus {
  open
  pending
  resolved
  closed
}

enum AdvertiserReviewStatus {
  pending_review
  published
  rejected
  archived
}

model User {
  id                       String                @id @default(cuid())
  role                     UserRole
  status                   AccountStatus         @default(active)
  firstName                String?
  lastName                 String?
  email                    String?               @unique
  phone                    String?               @unique
  passwordHash             String?
  city                     String?
  avatarUrl                String?
  emailVerified            Boolean               @default(false)
  phoneVerified            Boolean               @default(false)
  identityVerified         Boolean               @default(false)
  professionalVerified     Boolean               @default(false)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  deletedAt                DateTime?
  professionalProfile      ProfessionalProfile?
  verificationRequests     VerificationRequest[] @relation("VerificationRequests")
  verificationReviews      VerificationRequest[] @relation("VerificationReviews")
  sessions                 UserSession[]
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]            @relation("ActorAuditLogs")
  files                    FileAsset[]
  hotelProperties          HotelProperty[]
  realEstateListings       RealEstateListing[]
  vehicleListings          VehicleListing[]
  tripListings             TripListing[]
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  notifications            Notification[]
  reports                  Report[]              @relation("ReporterReports")
  supportTickets           SupportTicket[]
  favorites                Favorite[]
  savedAlerts              SavedAlert[]
  emailVerificationTokens  EmailVerificationToken[]
  businessEmailsEnabled    Boolean               @default(false)
  advertiserReviewsReceived AdvertiserReview[]    @relation("AdvertiserReviewsReceived")
  advertiserReviewsWritten  AdvertiserReview[]    @relation("AdvertiserReviewsWritten")

  @@index([role, status])
  @@index([createdAt])
}

model UserSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  ipAddress    String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  lastUsedAt    DateTime?
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
}

model RefreshToken {
  id          String      @id @default(cuid())
  userId      String
  sessionId   String
  tokenHash   String      @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  consumedAt  DateTime?
  parentTokenId String?    @unique
  parentToken RefreshToken? @relation("RefreshRotation", fields: [parentTokenId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  successor   RefreshToken? @relation("RefreshRotation")
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([sessionId, revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model ProfessionalProfile {
  id                String           @id @default(cuid())
  userId            String           @unique
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalType  ProfessionalType
  businessName      String
  city              String?
  address           String?
  description       String?
  logoUrl           String?
  openingDate       DateTime?
  openingHours      String?
  professionalPhone String?
  professionalEmail String?
  whatsappNumber    String?
  website           String?
  verified          Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model AdvertiserReview {
  id               String                 @id @default(cuid())
  advertiserUserId String
  advertiser       User                   @relation("AdvertiserReviewsReceived", fields: [advertiserUserId], references: [id], onDelete: Cascade)
  reviewerUserId   String?
  reviewer         User?                  @relation("AdvertiserReviewsWritten", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  rating           Int
  comment          String?
  module           PencmiModule?
  targetType       TargetType?
  targetId         String?
  status           AdvertiserReviewStatus @default(pending_review)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  publishedAt      DateTime?
  moderatedAt      DateTime?

  @@index([advertiserUserId, status, createdAt])
  @@index([reviewerUserId, createdAt])
  @@index([module, targetType, targetId])
}

model AuditLog {
  id          String       @id @default(cuid())
  actorUserId String?
  actor       User?        @relation("ActorAuditLogs", fields: [actorUserId], references: [id])
  action      String
  module      PencmiModule
  targetType  TargetType?
  targetId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime     @default(now())

  @@index([actorUserId, createdAt])
  @@index([module, targetType, targetId])
}

model FileAsset {
  id          String         @id @default(cuid())
  ownerUserId String?
  owner       User?          @relation(fields: [ownerUserId], references: [id])
  module      PencmiModule
  visibility  FileVisibility @default(private)
  mimeType    String
  sizeBytes   Int
  storageKey  String
  publicUrl   String?
  metadata    Json?
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  usages      FileUsage[]

  @@index([ownerUserId, module])
}

model FileUsage {
  id        String     @id @default(cuid())
  fileId    String
  file      FileAsset  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  targetType TargetType
  targetId   String
  createdAt DateTime   @default(now())

  @@index([targetType, targetId])
}

model HotelProperty {
  id              String      @id @default(cuid())
  ownerUserId     String
  owner           User        @relation(fields: [ownerUserId], references: [id])
  status          ListingStatus @default(draft)
  slug            String      @unique
  name            String
  propertyType    String
  city            String
  region          String?
  address         String?
  description     String?
  contactSettings Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  rooms           HotelRoom[]
  reservationRequests HotelReservationRequest[]
  integration     HotelIntegration?

  @@index([ownerUserId, status])
  @@index([city, status])
}

model HotelRoom {
  id         String        @id @default(cuid())
  propertyId String
  property   HotelProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  roomType   String?
  capacity   Int?
  metadata   Json?
  status     ListingStatus @default(active)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  rates      HotelRoomRate[]
  availability HotelRoomAvailability[]
  restrictions HotelRestriction[]
  reservationRequests HotelReservationRequest[]
  stockAllocations HotelStockAllocation[]
  icalExportToken String? @unique
  icalImports HotelIcalImport[]
  externalBlocks HotelExternalBlock[]

  @@index([propertyId, status])
}

model HotelRoomRate {
  id        String    @id @default(cuid())
  roomId    String
  room      HotelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date      DateTime
  ratePlan  String
  price     Int
  currency  String    @default("FCFA")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([roomId, date, ratePlan])
}

model HotelRoomAvailability {
  id        String    @id @default(cuid())
  roomId    String
  room      HotelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date      DateTime
  available Int
  status    String    @default("open")
  reliableUntil DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([roomId, date])
}

model HotelRestriction {
  id        String    @id @default(cuid())
  roomId    String
  room      HotelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date      DateTime
  stopSell  Boolean   @default(false)
  minStay   Int?
  maxStay   Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([roomId, date])
}

model HotelReservationRequest {
  id          String        @id @default(cuid())
  propertyId  String
  property    HotelProperty @relation(fields: [propertyId], references: [id])
  roomId      String?
  room        HotelRoom? @relation(fields: [roomId], references: [id], onDelete: Restrict)
  units       Int?
  idempotencyKey String? @unique
  requestFingerprint String?
  clientUserId String?
  clientName  String?
  clientPhone String?
  clientEmail String?
  checkIn     DateTime?
  checkOut    DateTime?
  guests      Int?
  message     String?
  status      RequestStatus @default(new)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  allocations HotelStockAllocation[]
  events      HotelReservationEvent[]
  channelEvents HotelChannelEvent[]

  @@index([propertyId, status, createdAt])
  @@index([roomId, checkIn, checkOut])
  @@index([propertyId, requestFingerprint, createdAt], map: "HotelReservationRequest_propertyId_fingerprint_createdAt_idx")
}

model HotelStockAllocation {
  id String @id @default(cuid())
  requestId String
  request HotelReservationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  roomId String
  room HotelRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  date DateTime
  units Int
  createdAt DateTime @default(now())
  releasedAt DateTime?
  // When the channel manager acknowledged the reservation: the availability it sends after
  // that date already counts these units.
  channelAckedAt DateTime?

  @@unique([requestId, date])
  @@index([roomId, date, releasedAt])
}

model HotelReservationEvent {
  id String @id @default(cuid())
  requestId String
  request HotelReservationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorUserId String?
  fromStatus RequestStatus?
  toStatus RequestStatus
  note String?
  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
}

model HotelIntegration {
  id         String        @id @default(cuid())
  propertyId String        @unique
  property   HotelProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  status     String        @default("inactive")
  // none | ical | channel_manager
  syncMode   String        @default("none")
  autoConfirm Boolean      @default(false)
  hotelCode  String?       @unique
  channelPartnerId String?
  channelPartner HotelChannelPartner? @relation(fields: [channelPartnerId], references: [id], onDelete: SetNull)
  lastSyncAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  channelEvents HotelChannelEvent[]

  @@index([channelPartnerId])
}

model HotelIcalImport {
  id            String    @id @default(cuid())
  roomId        String
  room          HotelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  url           String
  unitsPerEvent Int       @default(1)
  active        Boolean   @default(true)
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  blocks        HotelExternalBlock[]

  @@index([roomId])
  @@index([active, lastAttemptAt])
}

model HotelExternalBlock {
  id       String          @id @default(cuid())
  importId String
  import   HotelIcalImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  roomId   String
  room     HotelRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date     DateTime
  units    Int

  @@unique([importId, date])
  @@index([roomId, date])
}

model HotelChannelPartner {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  secretHash String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  // Notified at each reservation event. The signing secret is encrypted (AES-256-GCM,
  // HOTEL_WEBHOOK_ENCRYPTION_KEY): Pencmi needs it to sign.
  webhookUrl    String?
  webhookSecret String?
  integrations HotelIntegration[]
  webhookDeliveries HotelChannelWebhookDelivery[]
}

model HotelChannelWebhookDelivery {
  id             String              @id @default(cuid())
  partnerId      String
  partner        HotelChannelPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  // One notification per reservation event. Withdrawn with it when the event disappears.
  channelEventId String?             @unique
  channelEvent   HotelChannelEvent?  @relation(fields: [channelEventId], references: [id], onDelete: Cascade)
  // reservation.commit | reservation.cancel | ping
  type           String
  hotelCode      String?
  // pending | sending | retrying | sent | failed
  status         String              @default("pending")
  attempts       Int                 @default(0)
  nextAttemptAt  DateTime            @default(now())
  lockedUntil    DateTime?
  lastStatus     Int?
  lastError      String?
  createdAt      DateTime            @default(now())
  sentAt         DateTime?

  @@index([status, nextAttemptAt])
  @@index([partnerId, createdAt])
}

model HotelChannelEvent {
  id            String                  @id @default(cuid())
  integrationId String
  integration   HotelIntegration        @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  requestId     String
  request       HotelReservationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // commit | cancel
  kind          String
  createdAt     DateTime                @default(now())
  deliveredAt   DateTime?
  ackedAt       DateTime?
  webhookDelivery HotelChannelWebhookDelivery?

  @@unique([requestId, kind])
  @@index([integrationId, ackedAt, createdAt])
}








model RealEstateListing {
  id          String        @id @default(cuid())
  ownerUserId String
  owner       User          @relation(fields: [ownerUserId], references: [id])
  status      ListingStatus @default(draft)
  slug        String        @unique
  title       String
  description String?
  transaction String?
  propertyType String?
  city        String
  neighborhood String?
  price       Int?
  currency    String        @default("FCFA")
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  visitRequests RealEstateVisitRequest[]

  @@index([ownerUserId, status])
  @@index([city, status])
}

model RealEstateVisitRequest {
  id        String             @id @default(cuid())
  listingId String
  listing   RealEstateListing  @relation(fields: [listingId], references: [id])
  clientUserId String?
  clientName String?
  clientPhone String?
  clientEmail String?
  preferredDate DateTime?
  message   String?
  status    RequestStatus      @default(new)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([listingId, status, createdAt])
}

model VehicleListing {
  id          String        @id @default(cuid())
  ownerUserId String
  owner       User          @relation(fields: [ownerUserId], references: [id])
  status      ListingStatus @default(draft)
  slug        String        @unique
  title       String
  description String?
  vehicleMode String
  city        String
  price       Int?
  currency    String        @default("FCFA")
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  rentalRequests VehicleRentalRequest[]
  availabilityBlocks VehicleAvailabilityBlock[]
  chauffeurRequests VehicleChauffeurRequest[]

  @@index([ownerUserId, status])
  @@index([vehicleMode, city, status])
}

/** Dates a rental vehicle is not available outside Péncmi (maintenance, rented elsewhere...). End date excluded. */
model VehicleAvailabilityBlock {
  id              String         @id @default(cuid())
  listingId       String
  listing         VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  reason          String?
  createdByUserId String?
  createdAt       DateTime       @default(now())

  @@index([listingId, startDate])
}

model VehicleRentalRequest {
  id        String         @id @default(cuid())
  listingId String
  listing   VehicleListing @relation(fields: [listingId], references: [id])
  clientUserId String?
  clientName String?
  clientPhone String?
  clientEmail String?
  startDate DateTime?
  endDate   DateTime?
  message   String?
  status    RequestStatus  @default(new)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model VehicleChauffeurRequest {
  id        String         @id @default(cuid())
  listingId String
  listing   VehicleListing @relation(fields: [listingId], references: [id])
  clientUserId String?
  clientName String?
  clientPhone String?
  clientEmail String?
  pickupCity String?
  destinationCity String?
  serviceDate DateTime?
  message   String?
  status    RequestStatus  @default(new)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model TripListing {
  id          String        @id @default(cuid())
  ownerUserId String
  owner       User          @relation(fields: [ownerUserId], references: [id])
  status      ListingStatus @default(draft)
  slug        String        @unique
  title       String
  vehicleType String
  departureCity String
  arrivalCity String
  departurePoint String?
  arrivalPoint String?
  departureDate DateTime?
  departureTime String?
  pricePerSeat Int?
  currency     String       @default("FCFA")
  availableSeats Int?
  metadata     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  seatRequests TripSeatRequest[]
  occurrences TripOccurrence[]

  @@index([ownerUserId, status])
  @@index([departureCity, arrivalCity, status])
}

model TripSeatRequest {
  id        String      @id @default(cuid())
  tripId    String
  trip      TripListing @relation(fields: [tripId], references: [id])
  clientUserId String?
  clientName String?
  clientPhone String?
  clientEmail String?
  requestedSeats Int
  occurrenceId String?
  occurrence TripOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  allocatedSeats Int?
  quotedPricePerSeat Int?
  luggage   Boolean?
  message   String?
  status    RequestStatus @default(new)
  /** Given when the seats are confirmed; checked at boarding. */
  ticketCode String?      @unique
  /** null until boarding: boarded | no_show */
  boardingStatus String?
  boardedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([tripId, status, createdAt])
  @@index([occurrenceId, status])
}

model TripOccurrence {
  id String @id
  tripId String
  trip TripListing @relation(fields: [tripId], references: [id])
  serviceDate DateTime @db.Date
  departureAt DateTime
  estimatedArrivalAt DateTime?
  totalCapacity Int
  offeredSeats Int
  confirmedSeats Int @default(0)
  remainingSeats Int
  pricePerSeat Int
  cancelledAt DateTime?
  cancellationReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requests TripSeatRequest[]

  @@unique([tripId, departureAt])
  @@index([departureAt, cancelledAt])
}

model Conversation {
  id          String                    @id @default(cuid())
  module      PencmiModule
  targetType  TargetType?
  targetId    String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages    Message[]

  @@index([module, targetType, targetId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String
  sender         User         @relation(fields: [senderUserId], references: [id])
  body           String
  attachmentIds  String[]
  hiddenAt       DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderUserId, createdAt])
}

model ContactEvent {
  id        String        @id @default(cuid())
  module    PencmiModule
  source    ContactSource
  targetType TargetType?
  targetId  String?
  ownerUserId String?
  clientUserId String?
  metadata  Json?
  createdAt DateTime      @default(now())

  @@index([module, targetId, createdAt])
  @@index([ownerUserId, createdAt])
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    PencmiModule
  type      String
  priority  NotificationPriority @default(normal)
  status    NotificationStatus   @default(unread)
  title     String
  message   String
  targetUrl String?
  metadata  Json?
  createdAt DateTime             @default(now())
  readAt    DateTime?

  @@index([userId, status, createdAt])
}

model EmailTemplate {
  id        String    @id @default(cuid())
  key       String    @unique
  subject   String
  body      String
  variables String[]
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model EmailLog {
  id          String      @id @default(cuid())
  templateKey String?
  toEmail     String
  subject     String
  status      EmailStatus @default(pending)
  payload     Json?
  error       String?
  createdAt   DateTime    @default(now())
  sentAt      DateTime?

  @@index([status, createdAt])
}

model Favorite {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    PencmiModule
  targetId  String
  createdAt DateTime     @default(now())

  @@unique([userId, module, targetId])
}

model SavedAlert {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    PencmiModule
  criteria  Json
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Report {
  id             String         @id @default(cuid())
  module         PencmiModule
  targetType     TargetType
  targetId       String
  reporterUserId String?
  reporter       User?          @relation("ReporterReports", fields: [reporterUserId], references: [id])
  advertiserId   String?
  reason         String
  message        String?
  priority       ReportPriority @default(normal)
  status         ReportStatus   @default(new)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  decisions      ModerationDecision[]

  @@index([module, status, priority])
  @@index([targetType, targetId])
}

model ModerationDecision {
  id            String     @id @default(cuid())
  reportId      String?
  report        Report?    @relation(fields: [reportId], references: [id])
  adminUserId   String
  targetType    TargetType
  targetId      String
  action        String
  reason        String?
  messageToUser String?
  internalNote  String?
  createdAt     DateTime   @default(now())

  @@index([reportId, createdAt])
}

model VerificationRequest {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation("VerificationRequests", fields: [userId], references: [id], onDelete: Cascade)
  type             String
  status           RequestStatus @default(new)
  reason           String?
  reviewedByUserId String?
  reviewedBy       User?         @relation("VerificationReviews", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  documents        VerificationDocument[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model VerificationDocument {
  id                    String              @id @default(cuid())
  verificationRequestId  String
  verificationRequest    VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)
  fileId                String
  documentType          String
  createdAt             DateTime            @default(now())

  @@index([verificationRequestId])
}

model SupportCategory {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model SupportTicket {
  id        String              @id @default(cuid())
  userId    String?
  user      User?               @relation(fields: [userId], references: [id])
  categoryId String?
  subject   String
  status    SupportTicketStatus @default(open)
  priority  NotificationPriority @default(normal)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  messages  SupportMessage[]
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderUserId String?
  body      String
  createdAt DateTime      @default(now())
}

model ContentPage {
  id        String           @id @default(cuid())
  slug      String           @unique
  title     String
  subtitle  String?
  updatedByUserId String?
  status    ListingStatus    @default(draft)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  sections  ContentSection[]
  versions  ContentVersion[]
}

model ContentSection {
  id        String      @id @default(cuid())
  pageId    String
  page      ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key       String
  content   Json
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([pageId, key])
}

model ContentVersion {
  id        String      @id @default(cuid())
  pageId    String
  page      ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  snapshot  Json
  createdBy String?
  createdAt DateTime    @default(now())
}

model FaqItem {
  id        String    @id @default(cuid())
  module    PencmiModule?
  question  String
  answer    String
  category  String?
  active    Boolean   @default(true)
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model SeoMeta {
  id        String    @id @default(cuid())
  path      String    @unique
  title     String?
  description String?
  noindex   Boolean   @default(false)
  canonical String?
  structuredData Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model SeoRedirect {
  id        String    @id @default(cuid())
  source    String    @unique
  target    String
  statusCode Int      @default(301)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model GeoEntity {
  id        String    @id @default(cuid())
  slug      String    @unique
  module    PencmiModule
  name      String
  data      Json
  public    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model TrackingEvent {
  id        String       @id @default(cuid())
  module    PencmiModule
  eventType String
  targetType TargetType?
  targetId  String?
  userId    String?
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([module, targetId, createdAt])
  @@index([eventType, createdAt])
}

model BillingPlan {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  active    Boolean   @default(false)
  price     Int?
  currency  String    @default("FCFA")
  features  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AdvertiserSubscription {
  id        String    @id @default(cuid())
  userId    String
  planId    String
  status    String    @default("inactive")
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
}

model IdempotencyKey {
  id        String    @id @default(cuid())
  key       String    @unique
  scope     String
  response  Json?
  createdAt DateTime  @default(now())
  expiresAt DateTime
}
